{
  "name": "@koeru/talks",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dekc",
    "lint": "dekc lint --visual",
    "build": "dekc build && dekc pdf",
    "check": "tsc && dekc lint --visual && dekc build && bun run check:dist",
    "check:dist": "git diff --exit-code -- 'decks/*/dist/*.html' && test -z \"$(git ls-files --others --exclude-standard -- 'decks/*/dist/*.html')\""
  },
  "devDependencies": {
    "@hajimism/dek": "0.6.4",
    "@tsconfig/strictest": "2.0.9",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
